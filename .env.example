# Copy to .env and fill in. VITE_* vars are read at build/dev time. Restart the dev server after edits.
# Swap providers by changing ONLY this file: set VITE_AI_PROVIDER + that provider's key (+ model).
# When a provider is named here AND its key is set, .env overrides the in-app Settings.

# Active provider: "gemini" or "openai"
VITE_AI_PROVIDER=gemini

# --- Gemini (Google AI Studio) ---
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_MODEL=gemini-flash-latest

# --- OpenAI (paid) ---
VITE_OPENAI_API_KEY=your-openai-api-key
VITE_OPENAI_MODEL=gpt-4o-mini
