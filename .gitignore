node_modules/
dist/
.DS_Store

# Secrets — never commit (holds the live AI API key). .env.example IS committed as a template.
.env
.env.local
.env.*.local

# Real personal data (PII: student/teacher names, parents, income, GPS). The app ships on the
# synthetic Database/demo/ set, which IS committed. Only the raw root CSVs are excluded.
Database/*.csv

# public/data, public/data-tuned and public/data-v2 are deliberately NOT ignored.
# This is a static site with no backend: the browser fetches these CSVs by URL, so a file that is
# not committed does not exist in production and its request 404s. They were once ignored and
# force-added, which left the rules in place while the files were tracked — so every NEW file added
# to these directories was silently dropped from the build. That is what broke the Real ·26 toggle
# and the Preview attendance tables. Keeping the rules off means a new file is simply committed.
# These datasets contain real personal data, which is why THIS REPOSITORY MUST STAY PRIVATE and the
# deployment stays behind its team password.

# Claude Code secrets (keep .gitkeep)
.claude-project/secrets/*
!.claude-project/secrets/.gitkeep

# Temporary plans (keep .gitkeep)
.claude-project/status/temp/*
!.claude-project/status/temp/.gitkeep

# Local Claude settings
.claude/settings.local.json
